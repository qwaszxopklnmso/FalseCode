#include <bits/stdc++.h>
using namespace std;

struct node {
string id;
int age;
bool operator < (const node & x) const {
  if (age >= 60 && x.age >= 60) {
    if (age != x.age) return age > x.age;
    return id < x.id;
  }
  if (age >= 60) return true;
  if (x.age >= 60) return false;
  return false;
}
}a[105];
int n;
int main() {
  cin >> n;
  for (int i = 1; i <= n; ++ i) {
    cin >> a[i].id >> a[i].age;
  }
  stable_sort (a + 1, a + n + 1);
  for (int i = 1; i <= n; ++ i) {
    cout << (a[i].id) << endl;
  }
  return 0;
}
