#include <bits/stdc++.h>
using namespace std;

int MakePal(int x) {
  int r = x;
  int t = x / 10;
  while (t > 0) r = r * 10 + t % 10, t = t / 10;
  return r;
}
bool IsPrime(int x) {
  if (x < 2) return false;
  int i = 2;
  while (i * i <= x) {
    if (x % i == 0) return false;
    i ++;
  }
  return true;
}
int main() {
  freopen ("P1217.in", "r", stdin);
  freopen ("P1217.out", "w", stdout);
  int a = 0;
  int b = 0;
  cin >> a >> b;
  int prefix = 1;
  while (prefix <= 9) {
    int pal = MakePal (prefix);
    if (pal >= a && pal <= b && IsPrime (pal)) cout << (pal) << endl;
    prefix = prefix + 1;
  }
  if (11 >= a && 11 <= b) cout << (11) << endl;
  prefix = 10;
  while (prefix <= 9999) {
    int pal = MakePal (prefix);
    if (pal >= a && pal <= b && IsPrime (pal)) cout << (pal) << endl;
    prefix = prefix + 1;
  }
  return 0;
}
