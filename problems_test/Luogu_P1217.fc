Def MakePal(x -> int) -> int {
	r = x -> int;
	t = x / 10 -> int;
	While t > 0 {
		r = r * 10 + t % 10;
		t = t / 10;
	}
	Return r;
}
Def IsPrime(x -> int) -> bool {
	If x < 2 Then Return false;
	i = 2 -> int;
	While i * i <= x {
		If x % i == 0 Then Return false;
		++i;
	}
	Return true;
}
Def Main() {
	a = 0 -> int;
	b = 0 -> int;
	In to a, b;
	prefix = 1 -> int;
	While prefix <= 9 {
		pal = MakePal(prefix) -> int;
		If pal >= a && pal <= b && IsPrime(pal) Then Out pal, Nl;
		++prefix;
	}
	If 11 >= a && 11 <= b Then Out 11, Nl;
	prefix = 10;
	While prefix <= 9999 {
		pal = MakePal(prefix) -> int;
		If pal >= a && pal <= b && IsPrime(pal) Then Out pal, Nl;
		++prefix;
	}
	Return 0;
}
