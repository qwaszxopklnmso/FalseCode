#include <bits/stdc++.h>
using namespace std;

int Gcd(int x, int y) {
  while (y > 0) {
    int t = x % y;
    x = y;
    y = t;
  }
  return x;
}
int main() {
  freopen ("T585079.in", "r", stdin);
  freopen ("T585079.out", "w", stdout);
  int n = 0;
  cin >> n;
  int ans = 0;
  for (int c = 1; c <= n; ++ c) {
    for (int b = c + 1; b <= n; ++ b) {
      int den = b - c;
      int num = b * c;
      if (num % den == 0) {
        int a = num / den;
        if (a > b && a <= n && Gcd (Gcd (a, b), c) == 1) ans = ans + 1;
      }
    }
  }
  cout << (ans);
  cout << endl;
  return 0;
}
