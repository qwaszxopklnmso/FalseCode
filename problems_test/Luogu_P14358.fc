Def Main() {
	n = 0 -> int;
	m = 0 -> int;
	In to n, m;
	total = n * m -> int;
	a[101] -> int;
	For i = 0 -> int; i < total; ++i {
		In to a[i];
	}
	me = a[0] -> int;
	rank = 1 -> int;
	For i = 1 -> int; i < total; ++i {
		If a[i] > me Then ++rank;
	}
	col = (rank - 1) / n + 1 -> int;
	pos = (rank - 1) % n -> int;
	row = 0 -> int;
	If col % 2 == 1 Then row = pos + 1;
	Elif col % 2 == 0 Then row = n - pos;
	Out col, " ", row, Nl;
	Return 0;
}
