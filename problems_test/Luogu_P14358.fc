#include <bits/stdc++.h>
using namespace std;

int main() {
  int n = 0;
  int m = 0;
  cin >> n >> m;
  int total = n * m;
  int a[101];
  for (int i = 0; i < total; ++ i) {
    cin >> a[i];
  }
  int me = a[0];
  int rank = 1;
  for (int i = 1; i < total; ++ i) {
    if (a[i] > me) rank = rank + 1;
  }
  int col = (rank - 1) / n + 1;
  int pos = (rank - 1) % n;
  int row = 0;
  if (col % 2 == 1) row = pos + 1; else if (col % 2 == 0) row = n - pos;
  cout << (col);
  cout << (" ");
  cout << (row);
  cout << endl;
  return 0;
}
