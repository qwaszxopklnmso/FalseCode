// 屎山2：运算符大杂烩，无意义但不报错
Def Main() {
	a = 3 -> int;
	b = 4 -> int;
	a ^^= b;
	Out a;
	Out Nl;

	c = 100 -> int;
	c ##;
	Out c;
	Out Nl;

	d = 7 -> int;
	d ^= 5;
	Out d;
	Out Nl;

	e = 8 -> int;
	e %= 3;
	Out e;
	Out Nl;

	f = 2 -> int;
	f <<= 4;
	Out f;
	Out Nl;

	g = 15 -> int;
	g &= 9;
	Out g;
	Out Nl;

	h = 1 -> int;
	h |= 8;
	Out h;
	Out Nl;

	Out (3 ^^ 2 ^^ 2);
	Out Nl;
	Out (1 + 2 * 3 - 4 / 2 % 3 & 5 | 6 ^ 7 << 1 >> 1);
	Out Nl;

	i = 5 -> int;
	j = 2 -> int;
	Out (i > j ? i : j);
	Out Nl;
	Out (i < j ? i : j);
	Out Nl;

	Out (i && j ? i : j || 0 ? 1 : 0);
	Out Nl;

	Out (!i ? 1 : i == 5);
	Out Nl;

	Out (i != j && i >= j);
	Out Nl;

	Out (~i);
	Out Nl;

	k = -1 -> int;
	k = ~k;
	Out k;
	Out Nl;

	Return 0;
}
