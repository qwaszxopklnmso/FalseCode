vis[10] -> int;
d[10] -> int;
adj[10][10] -> int;
q[100] -> int;

Def BFS(s -> int, n -> int):
	head = 0 -> int;
	tail = 0 -> int;
	q[tail] = s;
	tail = tail + 1;
	vis[s] = 1;
	d[s] = 0;
	While head < tail {
		u = q[head] -> int;
		head = head + 1;
		For v = 0 -> int; v < n; v = v + 1 {
			If adj[u][v] == 1 && vis[v] == 0 {
				vis[v] = 1;
				d[v] = d[u] + 1;
				q[tail] = v;
				tail = tail + 1;
			}
		}
	}

Def Main() {
	n = 6 -> int;
	adj[0][1] = 1;
	adj[0][2] = 1;
	adj[1][3] = 1;
	adj[2][3] = 1;
	adj[2][4] = 1;
	adj[4][5] = 1;
	adj[1][5] = 1;
	BFS(0, n);
	Out d[3], Nl;
	Out d[5], Nl;
	Out d[4], Nl;
	Return 0;
}