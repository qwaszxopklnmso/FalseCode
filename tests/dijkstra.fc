const int INF = 1e9;
dist[10] -> int;
vis[10] -> int;
adj[10][10] -> int;

Def Dijkstra(s -> int, n -> int):
	For i = 0 -> int; i < n; i = i + 1 {
		dist[i] = INF;
	}
	dist[s] = 0;
	For it = 0 -> int; it < n; it = it + 1 {
		u = -1 -> int;
		For v = 0 -> int; v < n; v = v + 1 {
			If vis[v] == 0 && (u == -1 || dist[v] < dist[u]) {
				u = v;
			}
		}
		vis[u] = 1;
		For v = 0 -> int; v < n; v = v + 1 {
			If adj[u][v] > 0 && dist[u] + adj[u][v] < dist[v] {
				dist[v] = dist[u] + adj[u][v];
			}
		}
	}

Def Main() {
	n = 5 -> int;
	adj[0][1] = 2;
	adj[0][3] = 6;
	adj[1][2] = 3;
	adj[1][3] = 8;
	adj[1][4] = 5;
	adj[2][4] = 7;
	adj[3][4] = 9;
	Dijkstra(0, n);
	Out dist[2], Nl;
	Out dist[3], Nl;
	Out dist[4], Nl;
	Return 0;
}