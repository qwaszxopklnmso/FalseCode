struct Counter {
	count = 0 -> int;
	Def bump(x -> int) -> int {
		If x > 3 {
			count = count + x;
		} Else {
			count = count + 1;
		}
		Return count;
	}
};
Def Main() {
	c = new Counter() -> Counter*;
	i = 0 -> int;
	do {
		Out c->bump(i), Nl;
		i = i + 1;
	} While i < 5;
	do Out c->count; While false;
	Out Nl;
	Return 0;
}
