vis[10] -> int;
adj[10][10] -> int;
ans = 0 -> int;

Def DFS(u -> int, n -> int):
	vis[u] = 1;
	ans = ans + 1;
	For v = 0 -> int; v < n; v = v + 1 {
		If adj[u][v] == 1 && vis[v] == 0 {
			DFS(v, n);
		}
	}

Def Main() {
	n = 6 -> int;
	adj[0][1] = 1;
	adj[0][2] = 1;
	adj[1][3] = 1;
	adj[2][3] = 1;
	adj[2][4] = 1;
	adj[4][5] = 1;
	adj[1][5] = 1;
	DFS(0, n);
	Out ans;
	Out Nl;
	Return 0;
}