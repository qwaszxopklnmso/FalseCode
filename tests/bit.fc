Def Lowbit(x -> int) -> int:
	Return x & (-x);

Def Add(bit<> -> int, i -> int, v -> int):
	While i < bit.len {
		bit[i] = bit[i] + v;
		i = i + Lowbit(i);
	}

Def Sum(bit<> -> int, i -> int) -> int:
	s = 0 -> int;
	While i > 0 {
		s = s + bit[i];
		i = i - Lowbit(i);
	}
	Return s;

Def Main() {
	bit<> -> int;
	For i = 0 -> int; i < 9; i = i + 1 {
		bit.add(0);
	}
	Add(bit, 1, 3);
	Add(bit, 2, 5);
	Add(bit, 3, 2);
	Add(bit, 5, 7);
	Out Sum(bit, 5);
	Out Nl;
	Out Sum(bit, 3);
	Out Nl;
	Out Sum(bit, 8);
	Out Nl;
	Add(bit, 2, -5);
	Out Sum(bit, 5);
	Out Nl;
	Return 0;
}