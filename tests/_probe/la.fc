Def Main() {
	f = [](int x) -> int { Return x * x; };
	Out f(5), Nl;
	Out ([](int x, int y) { Return x + y; })(3, 4), Nl;
	s = 0 -> int;
	For i = 0 -> int; i < 3; ++i {
		s += ([](int v) { Return v * 2; })(i);
	}
	Out s, Nl;
	arr = {5, 2, 9} -> int[3];
	sort(arr, arr + 3, [](int a, int b) { Return a < b; });
	Out arr[0], arr[1], arr[2], Nl;
	g = []() { Out "no-capture", Nl; };
	g();
	Return 0;
}
