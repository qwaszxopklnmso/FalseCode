def Gcd(x -> int, y -> int) -> int {
	While y > 0 {
		t = x % y -> int;
		x = y;
		y = t;
	}
	Return x;
}

Def Main() {
	freopen("T585079.in", "r", stdin);
	freopen("T585079.out", "w", stdout);
	n = 0 -> int;
	In to n;
	ans = 0 -> int;
	For (c = 1 -> int; c <= n; ++c) {
		For (b = c + 1 -> int; b <= n; ++b) {
			den = b - c -> int;
			num = b * c -> int;
			If num % den == 0 {
				a = num / den -> int;
				If a > b && a <= n && Gcd(Gcd(a, b), c) == 1 Then ans = ans + 1;
			}
		}
	}
	Out ans;
	Out Nl;
	Return 0;
}
